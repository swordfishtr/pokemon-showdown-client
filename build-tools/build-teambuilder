console.log('All done!');

buf += `exports.GensTeambuilderTable = JSON.parse('${JSON.stringify(GensTeambuilderTable).replace(/['\\]/g, "\\$&")}');\n\n`;

fs.writeFileSync('play.pokemonshowdown.com/data/teambuilder-tables-gens.js', buf);


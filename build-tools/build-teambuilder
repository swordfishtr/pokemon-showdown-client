// region SIDE META OVERRIDE

function buildOverrides(mod, gtt) {
	const modDex = Dex.mod(mod);
	const modData = modDex.data;
	const parentDex = Dex.forGen(modDex.gen);

	const overrideSpeciesData = (gtt.overrideSpeciesData = {});
	for (const id in modData.Pokedex) {
		const modEntry = modDex.species.get(id);
		const parentEntry = parentDex.species.get(id);
		for (const key of overrideSpeciesKeys) {
			if (JSON.stringify(modEntry[key]) !== JSON.stringify(parentEntry[key])) {
				if (!overrideSpeciesData[id]) overrideSpeciesData[id] = {};
				overrideSpeciesData[id][key] = modEntry[key];
			}
		}
	}

	const overrideMoveData = (gtt.overrideMoveData = {});
	for (const id in modData.Moves) {
		const modEntry = modDex.moves.get(id);
		const parentEntry = parentDex.moves.get(id);
		for (const key of overrideMoveKeys) {
			if (key === 'category' && modDex.gen <= 3) continue;
			if (JSON.stringify(modEntry[key]) !== JSON.stringify(parentEntry[key])) {
				if (!overrideMoveData[id]) overrideMoveData[id] = {};
				overrideMoveData[id][key] = modEntry[key];
			}
		}
	}

	const overrideAbilityData = (gtt.overrideAbilityData = {});
	for (const id in modData.Abilities) {
		const modEntry = modDex.abilities.get(id);
		const parentEntry = parentDex.abilities.get(id);
		for (const key of overrideAbilityKeys) {
			if (JSON.stringify(modEntry[key]) !== JSON.stringify(parentEntry[key])) {
				if (!overrideAbilityData[id]) overrideAbilityData[id] = {};
				overrideAbilityData[id][key] = modEntry[key];
			}
		}
	}

	const overrideItemData = (gtt.overrideItemData = {});
	for (const id in modData.Items) {
		const modEntry = modDex.items.get(id);
		const parentEntry = parentDex.items.get(id);
		for (const key of overrideItemKeys) {
			if (JSON.stringify(modEntry[key]) !== JSON.stringify(parentEntry[key])) {
				if (!overrideItemData[id]) overrideItemData[id] = {};
				overrideItemData[id][key] = modEntry[key];
			}
		}
	}
}

function buildModOverrides(mod) {
	console.log(`Building overrides for ${mod} ...`);
	return buildOverrides(mod, GensTeambuilderTable.mods[mod]);
}
function buildFormatOverrides(mod, format) {
	console.log(`Building overrides for ${format} (${mod}) ...`);
	return buildOverrides(mod, GensTeambuilderTable.formats[format]);
}

for (const mod of [...sidemods]) {
	buildModOverrides(mod);
}

// endregion

// endregion

// region *** FORMATS ***

const check = {
	// TODO: Side mod detection.
	idToGen(id) {
		const formatsStartingWithNumber = [
			'35pokes',
			'35moves',
			'1v1',
		];
		for(const x of formatsStartingWithNumber) {
			const index = id.indexOf(x);
			if(index < 0) continue;
			id = id.slice(0, index);
		}
		const gen = /^(gen\d+)/.exec(id)?.[1];
		return gen ?? `gen${Dex.gen}`;
	},
	// This matters for 1. learnsets, 2. tiers.
	isNatdex(id) {
		return [
			/natdex/,
			/nationaldex/,
			/^gen\d+nd/,
		].some((regex) => regex.test(id));
	},
	idToLevel(id) {
		if([
			/babies/,
			/vgclc/,
		].some((regex) => regex.test(id))) {
			return 5;
		}
		if([
			/bss/,
			/vgc/,
		].some((regex) => regex.test(id))) {
			return 50;
		}
		return 100;
	},
	isDoubles(id) {
		return [
			/doubles/,
			/vgc/,
		].some((regex) => regex.test(id));
	},
	isCAP(id) {
		return false;
	},
	isTradebacks(id) {
		return false;
	},
	isFlipped(id) {
		return /flipped/.test(id);
	},
	isAAA(id) {
		return false;
	},
	isHackmons(id) {
		return false;
	},
	isStabmons(id) {
		return false;
	},
	isScalemons(id) {
		return [
			'gen9benjaminbutton',
		].includes(id);
	},
};

// region COMMON PROPS

for(const format of Dex.formats.all()) {
	if(format.team) continue;

	console.log(`Building format ${format} ...`);

	const ruleTable = Dex.formats.getRuleTable(format);

	const gtt = (GensTeambuilderTable.formats[format.id] ??= {});

	gtt.mod = check.idToGen(format.id);

	gtt.natdex = check.isNatdex(format.id) ? gtt.mod : null;
	if([
		'gen335pokesperfectb1',
		'gen535pokesperfectb2',
	].includes(format.id)) {
		gtt.natdex = 'gen9';
	}

	gtt.level = check.idToLevel(format.id);

	if(check.isDoubles(format.id)) gtt.doubles = 1;

	if(check.isCAP(format.id)) gtt.cap = 1;

	if(check.isTradebacks(format.id)) gtt.tradebacks = 1;

	if(check.isFlipped(format.id)) gtt.flipped = 1;

	if(check.isAAA(format.id)) gtt.aaa = 1;

	if(check.isHackmons(format.id)) gtt.hackmons = 1;

	if(check.isStabmons(format.id)) gtt.stabmons = 1;

	if(check.isScalemons(format.id)) gtt.scalemons = 1;

	if(
		(format.id.includes('35pokes') || format.id.includes('generationsdraft') || format.id === 'gen9test') &&
		!['gen9nd35pokesperfectz1'].includes(format.id)
	) {
		const whitelist = (gtt.whitelist ??= {});

		// Allow if not banned and not both of illegal and not unbanned
		for(const mon of Dex.species.all()) {
			if(
				!ruleTable.isBannedSpecies(mon) &&
				!(
					(
						mon.natDexTier === 'Illegal' ||
						mon.natDexTier.includes('CAP')
					) &&
					!(
						ruleTable.has(`+pokemon:${mon.id}`) ||
						ruleTable.has(`+basepokemon:${toID(mon.baseSpecies)}`)
					)
				)
			) {
				whitelist[mon.id] = 1;
			}
		}
	}

	if(format.id.includes('35moves') || format.id === 'gen9nd35pokesperfectz1') {
		const validator = new TeamValidator(format);

		const blacklist = (gtt.blacklist ??= {});
		for(const mon of Dex.species.all().filter((x) => x.natDexTier === 'AG')) {
			blacklist[mon.id] = 1;
		}

		const moves = (gtt.moves = {});
		const customNumCol = (gtt.customNumCol = {});
		for(const move of Dex.moves.all()) {
			if(!validator.ruleTable.has(`+move:${move.id}`)) continue;
			if(!move.realMove) {
				moves[move.id] = 1;
			}
			else {
				// Hidden Power [type]
				moves[toID(move.name)] = 1;
				continue;
			}
			for(const mon of Dex.species.all()) {
				if(validator.checkCanLearn(move, mon) === null) {
					customNumCol[mon.id] ??= 0;
					customNumCol[mon.id]++;
				}
			}
		}
	}
}

// endregion

// region GENS PROPS

// todo mapObjectValues?
function processDiffMon(mon) {
	const learnset = {};
	for(const x in mon.learnset) {
		learnset[x] = 1;
	}
	return learnset;
}

for(const mod of gensmods) {
	// Assuming gens mods are used by 1 format only.
	const formatid = mod === testmod ? 'gen9test' : Object.keys(GensTeambuilderTable.formats).find((id) => id.includes(mod));

	buildFormatOverrides(mod, formatid);

	const gtt = GensTeambuilderTable.formats[formatid];
	const learnsetDiff = (gtt.learnsetDiff = Dex.getLearnsetDiff(Dex.mod(mod), Dex.mod(gtt.mod)));
	for(const diffType in learnsetDiff) {
		for(const mon in learnsetDiff[diffType]) {
			if(!(mon in gtt.whitelist)) {
				delete learnsetDiff[diffType][mon];
				continue;
			}
			learnsetDiff[diffType][mon] = processDiffMon(learnsetDiff[diffType][mon]);
		}
	}
}

// endregion


	'mistball', 'moongeistbeam', 'photongeyser', 'prismaticlaser', 'psychicnoise', 'psychoboost', 'rockwrecker', 'sacredfire',
	'secretsword', 'sketch', 'sparklingaria', 'sunsteelstrike', 'supercellslam', 'tachyoncutter', 'terastarstorm', 'thunderclap',

#!/usr/bin/env node

/**
 * GensTeambuilderTable is Generations' flavor of BattleTeambuilderTable, which is a JSON object holding a
 * compilation of various data useful to the teambuilder, acting as a shortcut to most computation that would
 * be needed otherwise. Its type definition can be found in battle-dex-search.ts
 * 
 * Generations has significantly changed the shape and contents of this. As a server focused on 'whitelist'
 * kind of formats (draft leagues and micrometas), we skip dealing with Smogon tiers. We include many custom
 * properties required by the countless 35Pokes extended metagames and any other format that may need them.
 * 
 * `GensTeambuilderTable.mods` contains base mod data as in the server repository, including `gen9` which
 * should be the default mod for `Dex`. `GensTeambuilderTable.formats` contains format data. Formats have a
 * `mod` property that determines which mod the format is based on. The format can then have its own overrides
 * to its mod's properties.
 */

'use strict';

const fs = require("fs");
const path = require('path');

const Dex = require('../caches/pokemon-showdown/dist/sim/dex').Dex;
const TeamValidator = require('../caches/pokemon-showdown/dist/sim/team-validator').TeamValidator;
const toID = Dex.toID;

console.log('Beginning build-teambuilder!');

Dex.includeData();

let buf = '// DO NOT EDIT - automatically built with build-tools/build-teambuilder\n\n';

const GensTeambuilderTable = {
	mods: {},
	formats: {},
	learnsets: {},
	rowColors: {},
	build: (new Date()).toUTCString(),

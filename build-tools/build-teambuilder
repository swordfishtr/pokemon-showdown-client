const check = {
	idToMod(id) {
		if ([
			'gen9rdlsingles',
			'gen9rdlvgc',
		].includes(id)) {
			return 'champions';
		}
		const formatsStartingWithNumber = [
			'35pokes',
			'35moves',
			'35factory',
			'1v1',
			'4v4',
		];
		let sliced = id;
		for (const x of formatsStartingWithNumber) {
			const index = sliced.indexOf(x);
			if (index < 0) continue;
			sliced = sliced.slice(0, index);
		}
		const gen = /^(gen\d+)/.exec(sliced)?.[1] ?? `gen${Dex.gen}`;
		for (const mod of [...sidemods, ...sidemods.map((x) => `${gen}${x}`)]) {
			if (id.startsWith(mod)) {
				return mod;
			}
		}
		return gen ;
	},
	idToLevel(id) {
		if([
			/babies/,
		].some((regex) => regex.test(id))) {
			return 5;
		}
		if([
			/bss/,
			/vgc/,
			/rdl/,
		].some((regex) => regex.test(id))) {
			return 50;
		}
		return 100;
	},
	// This matters for 1. learnsets, 2. tiers.
	idToNatdex(id) {
		return [
			/natdex/,
			/nationaldex/,
			/^gen\d+nd/,
			// /^ver|^val|^acu|^cor/,
			/^rev|^col/,
		].some((regex) => regex.test(id));
	},
	idToRowColors(id) {
		if (/35pokes/.test(id) && ![
			'gen9nd35pokesperfectvgc1',
		].includes(id)) {
			return '35';
		}
		if (/(?<!re)generations/.test(id) || /^rev|^col/.test(id)) {
			return 'gens';
		}
	},
};

